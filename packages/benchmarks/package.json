{
  "name": "@stack-lift/benchmarks",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:benchmarks": "vitest run --config vitest.config.ts",
    "test:benchmarks:update": "vitest run --config vitest.config.ts --update-snapshots"
  },
  "dependencies": {
    "@stack-lift/angular-provider": "1.1.0",
    "@stack-lift/core": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
