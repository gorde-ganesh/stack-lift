{
  "name": "@stack-lift/shared",
  "version": "1.1.0",
  "description": "Shared TypeScript types for StackLift",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gorde-ganesh/stack-lift.git"
  },
  "homepage": "https://github.com/gorde-ganesh/stack-lift#readme",
  "bugs": {
    "url": "https://github.com/gorde-ganesh/stack-lift/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
