{
  "name": "stack-lift",
  "version": "0.5.0",
  "description": "Interactive upgrade copilot for Angular, React, and TypeScript frontends",
  "keywords": ["angular", "react", "typescript", "migration", "upgrade", "cli", "codemod"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gorde-ganesh/stack-lift.git"
  },
  "homepage": "https://github.com/gorde-ganesh/stack-lift#readme",
  "bugs": {
    "url": "https://github.com/gorde-ganesh/stack-lift/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "stack-lift": "./dist/cli.js",
    "skills": "./dist/skills-cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@stack-lift/angular-provider": "0.5.0",
    "@stack-lift/core": "0.5.0",
    "@stack-lift/shared": "0.5.0",
    "@inquirer/prompts": "^8.4.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
