{
  "name": "stack-lift-root",
  "private": true,
  "version": "0.5.0",
  "description": "CLI-first autonomous Angular migration engine",
  "type": "module",
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @stack-lift/cli dev",
    "test:benchmarks": "npm run test:benchmarks --workspace=packages/benchmarks",
    "test:benchmarks:update": "npm run test:benchmarks:update --workspace=packages/benchmarks"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorde-ganesh/stack-lift.git"
  },
  "homepage": "https://github.com/gorde-ganesh/stack-lift",
  "bugs": {
    "url": "https://github.com/gorde-ganesh/stack-lift/issues"
  },
  "license": "MIT"
}
