{
  "name": "stack-lift",
  "version": "0.4.7",
  "description": "AI-powered upgrade assistant for modernizing Angular, React, and legacy frontend codebases",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorde-ganesh/stack-lift.git"
  },
  "homepage": "https://github.com/gorde-ganesh/stack-lift",
  "bugs": {
    "url": "https://github.com/gorde-ganesh/stack-lift/issues"
  },
  "bin": {
    "stack-lift": "./dist/cli.js",
    "skills": "./dist/skills-cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test"
  },
  "files": [
    "dist",
    "skills"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1",
    "semver": "^7.6.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsup": "^8.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "angular",
    "react",
    "upgrade",
    "migration",
    "modernization",
    "cli"
  ],
  "license": "MIT"
}
